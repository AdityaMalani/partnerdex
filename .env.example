# ---------------------------------------------------------------------------
# Shopify Partner API
# ---------------------------------------------------------------------------
# Create a client under Partners Dashboard > Settings > Partner API clients.
# It needs the "View financials" and "Manage apps" permissions.
PARTNER_API_TOKEN=

# The numeric organization id. It is the number in your Partners Dashboard URL:
# https://partners.shopify.com/<PARTNER_ORGANIZATION_ID>/...
#
# Optional. Leave both blank to add your first organization in the dashboard
# instead, under Settings > Organizations.
PARTNER_ORGANIZATION_ID=

# Partner API version to target (YYYY-MM).
PARTNER_API_VERSION=2026-07

# ---------------------------------------------------------------------------
# Additional Partner organizations (optional)
# ---------------------------------------------------------------------------
# Organizations are managed in the dashboard under Settings > Organizations, and
# these variables are the bootstrap path into it. They *seed* the store: on every
# start, an organization named here that the store does not already have is
# added, and one it does have is left exactly as it is - token included. So a
# token rotated in the dashboard is not reverted by a stale value here, and an
# organization removed in the dashboard stays removed. Where the two disagree the
# dashboard says so; the stored one is in use.
#
# Leaving all of them empty is fine: the app starts, serves the dashboard, and
# syncs nothing until an organization is added.
#
# One instance can cover several Partner organizations. The organization id is
# part of the API endpoint path and each org needs its own token, so every extra
# org is a pair of variables:
#
#   PARTNER_ORG_2_ID=<numeric org id>
#   PARTNER_ORG_2_TOKEN=<that org's Partner API token>
#   PARTNER_ORG_2_LABEL=Second Org        # optional, for logs and `doctor`
#
# Any positive index works and they are read in numeric order. The pair above
# (PARTNER_ORGANIZATION_ID / PARTNER_API_TOKEN) stays the first organization and
# does not move, so adding a second org to a running deployment adds variables
# and changes none. `PARTNER_ORG_LABEL` names that first one.
#
# Apps from every configured organization appear in one dashboard and one set of
# figures; `apps.org_id` records which org each came from. A selector on each
# report narrows the figures to one organization; the default is all of them.
#
# PARTNER_ORG_2_ID=
# PARTNER_ORG_2_TOKEN=
# PARTNER_ORG_2_LABEL=

# ---------------------------------------------------------------------------
# Scope
# ---------------------------------------------------------------------------
# Comma-separated app ids to report on. Accepts numeric ids or full gids
# (gid://partners/App/1234). Leave empty to include every app in the org.
# Use this to exclude development/test apps from production reporting.
PARTNER_APP_IDS=

# Earliest date to backfill from (YYYY-MM-DD). Older history is skipped.
SYNC_START_DATE=2015-01-01

# ---------------------------------------------------------------------------
# Review tracking
# ---------------------------------------------------------------------------
# Reviews are read from your public App Store listing — the Partner API exposes
# no review data at all, and cannot say which listing an app is published under
# either. You map apps to listings on the **App listings** page in the
# dashboard, and that mapping is stored in the database.
#
# This variable is only a seed, for a container coming up on an empty volume
# that should sync before anyone opens the UI. Pairs are <appId>:<handle>, where
# the handle is the slug in apps.shopify.com/<handle>. It fills in apps that
# have no listing yet and never overwrites one entered in the dashboard.
#
# Leave it empty and set the listings in the UI instead.
APP_STORE_HANDLES=

# ---------------------------------------------------------------------------
# Funnel / BigQuery
# ---------------------------------------------------------------------------
# There is nothing to set here.
#
# The Funnel report's first two steps — listing page views, and clicks on the
# Add app button — happen before a merchant exists to the Partner API, so they
# can only be read from Google Analytics. Shopify sends `page_view` when someone
# opens your listing and `Add App button` when they click Install — the two
# events the funnel reads, fixed rather than configured. Both need a GA4
# measurement id on the listing (Partner Dashboard → your app →
# Distribution → Manage listing → Tracking information).
#
# The connection to that data is entered on the **Settings → BigQuery** page and
# stored in the database, not here. It is a credential that a partner rotates,
# on an instance they may not be able to redeploy.
#
# That page has two levels, matching the data: the Google Cloud project and the
# service-account key are shared by every app, while the GA4 export dataset is
# per app — one measurement id per listing means one export per listing.
#
# The service account needs exactly two roles:
#   BigQuery Data Viewer   on the GA4 export dataset
#   BigQuery Job User      on the project
#
# Steps 3 to 5 (installed, trial started, trial converted) come from the Partner
# API as usual, so the funnel is useful — and truthful about its missing top —
# without any of this.

# How often to walk every page of a listing instead of only the newest one, in
# hours. 0 sweeps on every sync.
#
# Only a full walk can notice that a review has *disappeared*, and it costs one
# request per ten reviews. A change in the listing's published review count
# forces a sweep early regardless, so this is really the ceiling on how long a
# removal can hide behind a count that happens to stay level — one review taken
# down in the same window another is posted.
REVIEW_SWEEP_HOURS=24

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------

# How old an event may be and still be worth announcing, in hours. 0 announces
# a backlog however old it is.
#
# A Slack channel only hears about events that happened after you switched its
# topic on, and the delivery ledger makes sure nothing is said twice. Neither
# stops something being said *late*: an instance that was offline for a week
# comes back to a week of undelivered history, and an upgrade that adds event
# types to a topic you already subscribe to turns every past occurrence of those
# types into unsent news at once. This is the backstop for both.
#
# A review is exempt from the strict reading of this, because the App Store
# publishes the day a review was posted and not the time. One stamped at
# midnight can be almost a day old before it happened, so it is given the length
# of its own day plus one REVIEW_SWEEP_HOURS on top.
NOTIFICATION_MAX_AGE_HOURS=24

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
DATABASE_PATH=./data/partnerdex.db
PORT=8787

# Set this only when a reverse proxy terminates TLS in front of partnerdex
# (Fly, Caddy, nginx, a load balancer). It tells the server to believe the
# X-Forwarded-For and X-Forwarded-Proto headers, which is what keeps the session
# cookie's Secure flag on and keys the login lockout to the real client.
#
# Leave it off when the port is reachable directly. Nothing would then stop a
# client from forging those headers — a new IP per request walks straight around
# the lockout.
TRUST_PROXY=false

# How many proxies really stand between a client and this process. Only read
# when TRUST_PROXY is on, and it must match the deployment exactly — Express
# walks X-Forwarded-For from the right and skips this many entries.
#
#   Fly.io in front of partnerdex        1   (measured against the live app)
#   Pangolin/Traefik in front of Fly     2   (the setup DEPLOY-RUNBOOK suggests)
#
# Too low and a proxy's own appended entry is read as the client, so everybody
# behind it shares one lockout bucket and one guesser locks out the population.
# Too high and the walk reaches the part of the header the client wrote, so a
# client picks its own bucket and every rate limit in the process is optional.
# Measure it after any change to what sits in front: a request that echoes
# req.ip, hit from a machine whose address you know, settles it in one call.
TRUST_PROXY_HOPS=1

# Public origin of the portal, used to build affiliate set-password links, e.g.
# https://partners.example.com. Leave it empty and links are emitted as relative
# paths (/portal#/set-password/<token>) for an operator to prefix by hand — this
# server has no reliable way to know its own public hostname behind a proxy, and
# a confidently wrong link is worse than an incomplete one.
PORTAL_BASE_URL=

# ---------------------------------------------------------------------------
# Outbound email (affiliate onboarding)
# ---------------------------------------------------------------------------
# The only way any of the imported affiliates gets into the portal is a
# set-password link, and there are hundreds of them. These settings are what
# turn `partnerdex onboard-affiliates` from a report into a send.
#
# Off by default, and off is a complete state rather than a broken one: links
# are still minted, a self-service request is still recorded, and nothing
# leaves the process. On, it is checked hard at startup — EMAIL_ENABLED=true
# with no SMTP_HOST, or an SMTP_FROM that is not an address, stops the process
# rather than letting a bulk run mark hundreds of people as emailed on the strength of
# a connection to nowhere.
#
# There is no mail dependency behind this. The SMTP client is written directly
# over node:net/node:tls in src/notifications/email.ts, which is why the
# supported surface is exactly what a transactional relay needs: EHLO,
# STARTTLS or implicit TLS, AUTH PLAIN/LOGIN, one recipient per message.
EMAIL_ENABLED=false

# Your relay. Any submission service works — the client speaks plain ESMTP.
SMTP_HOST=
# 587 negotiates TLS with STARTTLS; 465 is TLS from the first byte.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The From header. A display name is optional and, when present, is also the
# name the message uses about itself in its own text — so a partner reads the
# same words in the sender column and in the first line.
#   SMTP_FROM=Acme Partners <partners@example.com>
SMTP_FROM=

# TLS from the first byte rather than negotiated. Defaults to true on port 465
# and false everywhere else, which is right for every relay we know of.
SMTP_IMPLICIT_TLS=

# Permit a session that never reaches TLS. Leave it off unless the relay is on
# this machine: without TLS the relay password and every set-password link
# cross the network in the clear, and a set-password link opens an account.
# The client refuses a cleartext session rather than downgrading silently.
SMTP_ALLOW_INSECURE=false

# Pause between two messages in a bulk run, in milliseconds. Hundreds of messages
# delivered in ten seconds gets a sender greylisted or blocked; one a second
# arrives. At this default a full onboarding run takes about twelve minutes.
EMAIL_SEND_SPACING_MS=1200
# The terms a new affiliate agrees to when they apply, as an absolute http(s)
# URL. It is rendered as a link on a public page, so anything else is refused at
# startup rather than becoming a script sink.
#
# Empty is a deliberate state, not an unfinished one. Mantle's equivalent was
# never configured either, so not one of the imported affiliates has ever
# agreed to anything and this system is not the place to invent the document.
# Set it and the signup form shows the link, requires the box to be ticked, and
# records the URL and the instant against the affiliate. Leave it unset and
# signup still works, claiming no consent that did not happen.
#
# Point it at a versioned URL if the document will ever change: what is stored is
# the URL that was presented, so a document edited in place silently rewrites
# what every past applicant is recorded as having agreed to.
AFFILIATE_TERMS_URL=

# Password for the dashboard and the API behind it. Minimum 8 characters.
#
# Leave it empty and there is no login at all — the localhost default this tool
# has always had. Set it and every /api route except the health probe requires a
# session cookie, which is what makes exposing the port merely unwise rather
# than an open door. Changing it signs everyone out.
DASHBOARD_PASSWORD=

# How often `partnerdex serve` syncs in the background, in minutes. 0 turns the
# loop off and leaves syncing to `partnerdex sync` or your own cron.
#
# Runs never overlap: the next one is scheduled after the previous finishes, and
# repeated failures back off geometrically up to 30 minutes. Each run is
# incremental — it re-reads a 3-day overlap behind the last watermark — so a
# short interval costs little beyond a request per app.
SYNC_INTERVAL_MINUTES=5

# IANA timezone used to resolve period presets and bucket boundaries.
REPORTING_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Reporting defaults (every one is overridable per request)
# ---------------------------------------------------------------------------
# Fold annual plans into MRR at 1/12 of their annual price.
METRICS_INCLUDE_ANNUAL=true
# Add trailing-30-day metered usage revenue to MRR.
METRICS_INCLUDE_USAGE=true
# Count subscriptions that are still in trial (at their would-be price) in MRR.
METRICS_INCLUDE_TRIALS=false
# Count distinct shops rather than distinct charges for ARPU/churn populations.
METRICS_BY_SHOP=true

# A subscription is treated as having had a trial when its first paid charge
# lands more than this many days after activation.
TRIAL_MIN_GAP_DAYS=2
# Rolling window (days) for churn rate and its start-of-period denominator.
CHURN_WINDOW_DAYS=30
# Treat an app uninstall as ending any still-open subscription for that shop.
CHURN_ON_UNINSTALL=true
# Cancels followed by a new charge for the same shop+app within this many days
# are plan changes, not churn.
PLAN_CHANGE_WINDOW_DAYS=2

# Read-through cache TTL for metric responses, in seconds. 0 disables.
CACHE_TTL_SECONDS=600

# Seconds before one Partner API request is treated as a hang and retried.
# Not a latency budget — a page of a large connection can legitimately be slow.
# Milliseconds; defaults to 120000. Raise it on a slow link.
# PARTNER_REQUEST_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Affiliate program -> Partner API app mapping
# ---------------------------------------------------------------------------
# The affiliate programs were migrated from another platform, which keyed them
# by its own uuids. PartnerDex keys a merchant's charges by the Partner API app
# id, so reconciliation crosses that seam exactly once — here.
#
# These were source constants until they turned out to be deployment-specific
# values sitting in an otherwise publishable file. Absent is a valid state: the
# mapping simply has no entry, and every caller already falls back rather than
# guessing. It is only wrong if you are reconciling against real Partner API
# data, where a missing id means a program silently reconciles against nothing.
#
# Numeric Partner API app ids, from `apps` after a sync.
STOQ_APP_ID=
FILEMONK_APP_ID=

# GA4 export datasets, used only by the historical backfill script.
# Shaped `analytics_<ga4-property-id>`.
STOQ_GA4_DATASET=
FILEMONK_GA4_DATASET=
