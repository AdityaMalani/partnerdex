{
  "name": "partnerdex",
  "version": "0.1.0",
  "description": "Self-hosted analytics for Shopify apps: MRR, ARR, gross earnings, ARPU, LTV, churn and trials, queryable as-of any past date.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "partnerdex": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/cli.ts serve",
    "dev:web": "vite",
    "sync": "tsx src/cli.ts sync",
    "rebuild": "tsx src/cli.ts rebuild",
    "doctor": "tsx src/cli.ts doctor",
    "validate": "tsx src/cli.ts validate",
    "contacts:dump": "tsx src/cli.ts contacts:dump",
    "contacts:coverage": "tsx src/cli.ts contacts:coverage",
    "contacts:import": "tsx src/cli.ts contacts:import",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
